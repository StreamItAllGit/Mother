<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Mother.Core</AssemblyName>
    <RootNamespace>Mother.Core</RootNamespace>
    <Title>Mother Core Suite Engine</Title>
    <Product>Mother</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mother.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Foundation.Core">
      <HintPath>..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\version.txt" Link="version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\migrations\0001_initial_schema.sql" Link="migrations\0001_initial_schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
