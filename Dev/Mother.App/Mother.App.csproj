<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Mother.App</AssemblyName>
    <RootNamespace>Mother.App</RootNamespace>
    <StartupObject>Mother.App.Program</StartupObject>
    <ApplicationIcon>..\Assets\app_icon.ico</ApplicationIcon>
    <Title>Mother</Title>
    <Product>Mother</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ExcludeWebView2WpfWrapper" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Mother.Core\Mother.Core.csproj" />
    <ProjectReference Include="..\Mother.Server\Mother.Server.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Server">
      <HintPath>..\lib\Foundation.Server.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.UI">
      <HintPath>..\lib\Foundation.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Assets\app_icon.ico" Link="Assets\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Assets\logo.png" Link="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Mother.Server\wwwroot\**\*" Condition="Exists('..\Mother.Server\wwwroot')">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
