<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Mother.Installer</AssemblyName>
    <RootNamespace>Mother.Installer</RootNamespace>
    <ApplicationIcon>..\Assets\app_icon.ico</ApplicationIcon>
    <Title>Mother Setup</Title>
    <Product>Mother</Product>
    <Company>Personal Suite</Company>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">false</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Foundation.Core">
      <HintPath>..\lib\Foundation.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Foundation.Installer">
      <HintPath>..\lib\Foundation.Installer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="..\Assets\app_icon.ico" LogicalName="Mother.Installer.Assets.app_icon.ico" />
    <EmbeddedResource Include="..\Assets\logo.png" LogicalName="Mother.Installer.Assets.logo.png" />
  </ItemGroup>

  <Target Name="CompressFoundationAssemblies"
          BeforeTargets="AssignTargetPaths;PrepareResourceNames;PrepareResources">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;foreach ($n in @('Foundation.Core.dll','Foundation.Installer.dll')) { $src = Join-Path '$(MSBuildProjectDirectory)\..\lib' $n; $dst = Join-Path '$(MSBuildProjectDirectory)\$(IntermediateOutputPath)' ($n + '.gz'); $inBytes = [System.IO.File]::ReadAllBytes($src); $fs = [System.IO.File]::Create($dst); try { $gz = New-Object System.IO.Compression.GZipStream($fs, [System.IO.Compression.CompressionLevel]::Optimal); try { $gz.Write($inBytes, 0, $inBytes.Length) } finally { $gz.Dispose() } } finally { $fs.Dispose() } }&quot;" />
    <ItemGroup>
      <EmbeddedResource Remove="$(IntermediateOutputPath)Foundation.Core.dll.gz;$(IntermediateOutputPath)Foundation.Installer.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Core.dll.gz" LogicalName="Foundation.Core.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Installer.dll.gz" LogicalName="Foundation.Installer.dll.gz" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(InstallerPayloadArchive)' != '' and Exists('$(InstallerPayloadArchive)')">
    <EmbeddedResource Include="$(InstallerPayloadArchive)"
                      LogicalName="Mother.Installer.Embedded.payload.zip" />
  </ItemGroup>

</Project>
