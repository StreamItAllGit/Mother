<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mother.Core\Mother.Core.csproj" />
    <ProjectReference Include="..\Mother.Server\Mother.Server.csproj" />
    <ProjectReference Include="..\Mother.App\Mother.App.csproj" />
    <ProjectReference Include="..\Mother.Launcher\Mother.Launcher.csproj" />
    <ProjectReference Include="..\Mother.Installer\Mother.Installer.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Server">
      <HintPath>..\lib\Foundation.Server.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Launcher">
      <HintPath>..\lib\Foundation.Launcher.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.UI">
      <HintPath>..\lib\Foundation.UI.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Installer">
      <HintPath>..\lib\Foundation.Installer.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Automation">
      <HintPath>..\lib\Foundation.Automation.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="ExcludeWebView2WpfWrapper" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
