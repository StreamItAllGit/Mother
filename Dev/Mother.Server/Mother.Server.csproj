<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Mother.Server</AssemblyName>
    <RootNamespace>Mother.Server</RootNamespace>
    <Title>Mother Kestrel Gateway &amp; Suite UI Server</Title>
    <Product>Mother</Product>
    <NoWarn>$(NoWarn);ASP0022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mother.Core\Mother.Core.csproj" />
    <Reference Include="Foundation.Core">
      <HintPath>..\lib\Foundation.Core.dll</HintPath>
    </Reference>
    <Reference Include="Foundation.Server">
      <HintPath>..\lib\Foundation.Server.dll</HintPath>
    </Reference>
    <Content Include="..\suite.manifest.json" Link="suite.manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\mother.manifest.json" Link="mother.manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
